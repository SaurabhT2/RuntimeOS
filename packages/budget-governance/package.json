{
  "name": "@ai-gateway/budget-governance",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative, cumulative Budget & Cost Governance (architecture §43): BudgetPolicy/BudgetLedger/BudgetEnforcer, distinct from the advisory, single-request Cost Optimizer (§33). Ships in shadow mode by default (Blueprint §7 EM-10).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-gateway/core-contracts": "workspace:*",
    "@ai-gateway/config": "workspace:*",
    "@ai-gateway/telemetry": "workspace:*",
    "@ai-gateway/policy-engine": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
