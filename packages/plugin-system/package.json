{
  "name": "@ai-gateway/plugin-system",
  "version": "0.1.0",
  "private": true,
  "description": "The Gateway Plugin framework (architecture §11): plugin contract, registration, lifecycle, discovery, and loading. Not yet integrated into the Orchestrator — that wiring is EM-8's job.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-gateway/core-contracts": "workspace:*",
    "@ai-gateway/provider-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
